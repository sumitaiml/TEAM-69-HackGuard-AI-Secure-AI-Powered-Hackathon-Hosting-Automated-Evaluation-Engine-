# =====================================================================
# HackEval Backend Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# =====================================================================

SECRET_KEY=your_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hackeval_db
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hackeval_test

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash,gemini-flash-latest

# Handles every agent except pitch-deck (still Gemini, for multimodal images)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FALLBACKS=openai/gpt-oss-20b

WHISPER_MODEL_SIZE=base
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

DOCKER_SANDBOX_ENABLED=true
DOCKER_MEMORY_LIMIT=512m
DOCKER_CPU_CAP=1.0
DOCKER_TIMEOUT_SECONDS=60
DOCKER_PIDS_LIMIT=64
# Must match the fixed volume/network names docker-compose.yml creates -
# only change these if you also change them there.
SANDBOX_VOLUME_NAME=hackeval_sandbox_workspace
SANDBOX_NETWORK_NAME=hackeval-sandbox-net

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Upload limits (PRD: demo video 3-5 minutes, max 50MB)
MAX_ZIP_SIZE_MB=100
MAX_PPT_SIZE_MB=25
MAX_VIDEO_SIZE_MB=50
VIDEO_MIN_DURATION_SECONDS=180
VIDEO_MAX_DURATION_SECONDS=300

# Async task queue (Celery + Redis, runs via docker-compose)
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# Shared workspace for extracted submission source (docker-compose
# overrides this to /workspace, the shared named volume)
WORKSPACE_ROOT=./workspace

# Judge invites & email delivery
FRONTEND_BASE_URL=http://localhost:5173
JUDGE_INVITE_EXPIRY_DAYS=7
# Leave SMTP_HOST blank to get invite links back directly in the API
# response (dev_invite_link) instead of sending real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@hackeval.ai
SMTP_FROM_NAME=HackEval
SMTP_USE_TLS=true

PASSWORD_RESET_EXPIRY_HOURS=2
MAX_JUDGE_INVITE_CSV_SIZE_MB=1
MAX_JUDGE_INVITE_CSV_ROWS=500

# Agentic evaluation modules (see AI_Agents_Implementation_Plan.md)
ENABLE_TIMELINE_AGENT=true
ENABLE_PLAGIARISM_EXPLAINER_AGENT=true
ENABLE_REPO_VERIFICATION_AGENT=true
AGENT_MAX_TOOL_CALLS=10
ENABLE_PITCH_DECK_AGENT=true
