# =====================================================================
# HackGuard AI Backend Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# =====================================================================

SECRET_KEY=your_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL=sqlite:///./hackguard.db

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

WHISPER_MODEL_SIZE=base
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

DOCKER_SANDBOX_ENABLED=true
DOCKER_MEMORY_LIMIT=512m
DOCKER_CPU_CAP=1.0
DOCKER_TIMEOUT_SECONDS=60

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Upload limits (PRD: demo video 3-5 minutes, max 50MB)
MAX_ZIP_SIZE_MB=100
MAX_PPT_SIZE_MB=25
MAX_VIDEO_SIZE_MB=50
VIDEO_MIN_DURATION_SECONDS=180
VIDEO_MAX_DURATION_SECONDS=300
